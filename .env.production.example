# The environment variables for the server.
#
# Copy this to `.env.production` and fill it in, or - better - set them in
# the Liara console under "تنظیمات" (Settings) -> "متغیرها" (Env vars), so
# the secrets are not in a file that gets uploaded.
#
# The names have to be exactly these.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The MySQL of the server. On Liara it looks like this:
#   mysql://USER:PASSWORD@HOST:PORT/DATABASE
# If the app and the database are in the same private network, use the
# private address - it is faster and it does not leave the network.
#
# `connection_limit` caps the Prisma connection pool. Leave it in: a small
# database allows only a few connections, and Prisma's default pool size
# (CPU cores * 2 + 1) is more than that.
#
# `connect_timeout` is in seconds. Prisma's default is 5, which is not
# enough for a database that is still starting up.
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE?connection_limit=10&connect_timeout=30"

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# The secret that signs the session cookie. Generate a new one for the
# server - never reuse the development one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="a-long-random-string-of-at-least-32-characters"

# ---------------------------------------------------------------------------
# The admin panel
# ---------------------------------------------------------------------------
# The phone number that gets the ADMIN role when the database is seeded.
# It signs in through the normal login and can then open the panel.
ADMIN_PHONE=09123456789
# Several admins: ADMIN_PHONE="09123456789,09130000000"

# ---------------------------------------------------------------------------
# The SMS code (sms.ir)
# ---------------------------------------------------------------------------
# The key and the "Verify" template from the sms.ir panel. The balance has to
# be topped up, or the login code is not delivered.
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
# The name of the placeholder in the template text, e.g. "CODE".
SMSIR_CODE_PARAM=CODE

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# The Sentry DSN, if the errors are to be reported.
NEXT_PUBLIC_SENTRY_DSN=""
