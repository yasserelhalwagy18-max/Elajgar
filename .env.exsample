# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Database (MySQL - must match `provider = "mysql"` in prisma/schema.prisma)
# ---------------------------------------------------------------------------
#
# LOCAL (Docker): start the database with `docker compose up -d` and use:
#
#   DATABASE_URL="mysql://elajgar:elajgar@127.0.0.1:3307/elajgar?connection_limit=10&connect_timeout=30"
#
# The port follows MYSQL_PORT in `.env` (default 3307). 3307 rather than 3306
# because MySQL is often already installed on Windows and listening on 3306.
#
# HOSTED: point it at the managed server instead, and keep the same query
# parameters:
#
#   DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=REQUIRED&connection_limit=10&connect_timeout=30"
#
# `connection_limit` caps the Prisma connection pool. Leave it in: a hosted
# free tier may allow only 20 connections per MySQL service, while Prisma's
# default pool size is (CPU cores * 2 + 1) - on a shared host that is more
# than the database accepts, and the app fails with "too many connections".
#
# `connect_timeout` is in seconds. Prisma's default is 5, which is not enough
# for a managed service that was just powered on and is still starting up.
#
# `sslmode=REQUIRED` is for a hosted server that uses TLS. A local Docker
# container does not, so leave it out there.
DATABASE_URL="mysql://elajgar:elajgar@127.0.0.1:3307/elajgar?connection_limit=10&connect_timeout=30"

# The port the local Docker database listens on. Change it if 3307 is taken.
MYSQL_PORT=3307

# Long random string used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"

NEXT_PUBLIC_SENTRY_DSN=""

# sms.ir (OTP login SMS) - create a Verify template in the sms.ir panel first
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
# Parameter name used in the template text, e.g. "کد تایید شما: #CODE#" -> CODE
SMSIR_CODE_PARAM=CODE

# ---------------------------------------------------------------------------
# Admin panel
# ---------------------------------------------------------------------------
# The phone number that gets the ADMIN role when the database is seeded.
# That number signs in through the normal OTP login and can then open /admin.
ADMIN_PHONE=
# Several admins: ADMIN_PHONE="09120000000,09130000000"
ADMIN_PHONES=
