# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# MySQL connection string (must match `provider = "mysql"` in prisma/schema.prisma)
DATABASE_URL="mysql://USERNAME:PASSWORD@localhost:3306/DATABASENAME"

# Long random string used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"

NEXT_PUBLIC_SENTRY_DSN=""

# sms.ir (OTP login SMS) - create a Verify template in the sms.ir panel first
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
# Parameter name used in the template text, e.g. "کد تایید شما: #CODE#" -> CODE
SMSIR_CODE_PARAM=CODE

# ---------------------------------------------------------------------------
# Admin panel
# ---------------------------------------------------------------------------
# The phone number that gets the ADMIN role when the database is seeded.
# That number signs in through the normal OTP login and can then open /admin.
ADMIN_PHONE=
# Several admins: ADMIN_PHONE="09120000000,09130000000"
ADMIN_PHONES=
