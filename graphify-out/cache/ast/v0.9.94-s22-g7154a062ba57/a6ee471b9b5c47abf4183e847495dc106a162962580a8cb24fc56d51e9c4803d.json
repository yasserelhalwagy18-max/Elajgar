{"nodes": [{"id": "$graphify-root$_agents_skills_accessibility_scan_skill_md", "label": "SKILL.md", "file_type": "document", "node_kind": "page", "source_file": ".agents/skills/accessibility-scan/SKILL.md", "source_location": "L1", "frontmatter": {"name": "accessibility-scan", "description": "One page, automated tier \u2014 run the web accessibility (a11y) rule engine against a live page and locate every violation it can detect mechanically. Pass a URL, a config target name (e.g. `accesslint:accessibility-scan dev`), or nothing to use the default target from `accesslint.config.json`. Ensures a debuggable Chrome, runs the @accesslint/core engine over CDP, and returns a worklist of live-DOM WCAG 2.2 violations, each grounded to its DOM selector and source `file:line`. Locates; doesn&#x27;t edit. Use it", "argument-hint": "[target|url]", "allowed-tools": "Bash, Read, Glob, Grep, Skill, Task"}}, {"id": "$graphify-root$_agents_skills_accessibility_scan_skill_1_audit", "label": "1. Audit", "file_type": "document", "node_kind": "heading", "source_file": ".agents/skills/accessibility-scan/SKILL.md", "source_location": "L14"}, {"id": "$graphify-root$_agents_skills_accessibility_scan_skill_2_report", "label": "2. Report", "file_type": "document", "node_kind": "heading", "source_file": ".agents/skills/accessibility-scan/SKILL.md", "source_location": "L23"}, {"id": "$graphify-root$_agents_skills_accessibility_scan_skill_3_tear_down", "label": "3. Tear down", "file_type": "document", "node_kind": "heading", "source_file": ".agents/skills/accessibility-scan/SKILL.md", "source_location": "L33"}, {"id": "$graphify-root$_agents_skills_accessibility_scan_skill_notes", "label": "Notes", "file_type": "document", "node_kind": "heading", "source_file": ".agents/skills/accessibility-scan/SKILL.md", "source_location": "L39"}], "edges": [{"source": "$graphify-root$_agents_skills_accessibility_scan_skill_md", "target": "$graphify-root$_agents_skills_shared_methodology_md", "relation": "refer