{"nodes": [{"id": ".agents_skills_accessibility_audit_skill_accessibility_audit", "label": "Accessibility Audit (WCAG 2.2 / WCAG-EM)", "file_type": "concept", "source_file": ".agents/skills/accessibility-audit/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Whole site or product audit against WCAG 2.2 following WCAG-EM. Defines scope, samples representative pages and flows, runs automated scan and manual inspect tiers, produces one conformance report. Assesses; does not fix (use accessibility-fix) or diff (use accessibility-diff). One page with no sampling is a scan, not an audit."}, {"id": ".agents_skills_accessibility_audit_skill_wcag_em_methodology", "label": "WCAG-EM Methodology", "file_type": "concept", "source_file": ".agents/skills/accessibility-audit/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WCAG-EM steps: Scope, Explore, Sample, Evaluate, Report. Conformance has three states: pass/fail only for verified findings; everything flagged/human-required/not-exercised is undetermined."}, {"id": ".agents_skills_accessibility_audit_skill_evidence_basis", "label": "Evidence Basis Grading", "file_type": "concept", "source_file": ".agents/skills/accessibility-audit/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Evidence basis: verified (deterministic with cited proof), flagged (evidence captured, person decides), human-required (needs assistive technology or lived experience). Severity: critical/serious/moderate/minor."}, {"id": ".agents_skills_accessibility_audit_skill_conformance_ledger", "label": "Per-SC Conformance Ledger", "file_type": "concept", "source_file": ".agents/skills/accessibility-audit/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pass/fail asserted only for verified criteria. Flagged/human-required/not-exercised are undetermined and go to human. One sampled page failing an SC fails it for the whole scope at that level."}, {"id": ".agents_skills_accessibility_audit_skill_shared_methodology", "label": "Shared Methodology (../shared/methodology.md)", "file_type": "concept", "source_file": ".agents/skills/accessibility-audit/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared grounding and honesty conventions referenced by accessibility-audit, accessibility-diff, accessibility-fix, accessibility-inspect, accessibility-scan. Covers severity, no-proxy boundary, grounding."}], "edges": [{"source": ".agents_skills_accessibility_audit_skill_accessibility_audit", "target": ".agents_skills_accessibility_scan_skill_accessibility_scan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/accessibility-audit/SKILL.md", "source_location": null, "weight": 1.0}, {"source": ".agents_skills_accessibility_audit_skill_accessibility_audit", "target": ".agents_skills_accessibility_inspect_skill_accessibility_inspect", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/accessibility-audit/SKILL.md", "source_location": null, "weight": 1.0}, {"source": ".agents_skills_accessibility_audit_skill_accessibility_audit", "target": ".agents_skills_accessibility_fix_skill_accessibility_fix", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/accessibility-audit/SKILL.md", "source_location": null, "weight": 1.0}, {"source": ".agents_skills_accessibility_audit_skill_accessibility_audit", "target": ".agents_skills_accessibility_diff_skill_accessibility_diff", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/accessibil