    },
    {
      "id": "_agents_skills_prisma_database_setup_references_mongodb_mongodb_replica_set",
      "label": "MongoDB Replica Set",
      "file_type": "concept",
      "source_file": "/Users/sadegh/Elajgar/.agents/skills/prisma-database-setup/references/mongodb.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Required for transactions; standalone MongoDB instances do not support transactions (Atlas clusters are replica sets by default)."
    },
    {
      "id": "_agents_skills_prisma_database_setup_references_mongodb_mongodb_id_requirement",
      "label": "MongoDB _id field requirement (@map('_id'), @db.ObjectId)",
      "file_type": "concept",
      "source_file": "/Users/sadegh/Elajgar/.agents/skills/prisma-database-setup/references/mongodb.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "MongoDB models must have a mapped _id field using @id and @map('_id'), usually String with auto() and db.ObjectId; relation fields expect db.ObjectId."
    },
    {
      "id": "_agents_skills_prisma_database_setup_references_mongodb_prisma_6_mongodb_support",
      "label": "Prisma 6.x MongoDB support vs Prisma 7",
      "file_type": "concept",
      "source_file": "/Users/sadegh/Elajgar/.agents/skills/prisma-database-setup/references/mongodb.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "CLI still implements prisma init --datasource-provider mongodb and upstream repo retains MongoDB fixtures/tests; Prisma 7 can recognize MongoDB inputs but provides no supported MongoDB upgrade path."
    },
    {
      "id": "_agents_skills_prisma_database_setup_references_mysql_planetscale_relation_mode",
      "label": "PlanetScale relationMode = 'prisma'",
      "file_type": "concept",
      "source_file": "/Users/sadegh/Elajgar/.agents/skills/prisma-database-setup/references/mysql.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "PlanetScale uses MySQL but lacks foreign key constraints; relationMode = 'prisma' emulates foreign keys in Prisma."
    },
    {
      "id": "_agents_skills_prisma_database_setup_references_sqlite_sqlite_limitations",
      "label": "SQLite limitations (no enums, no scalar lists, file write lock)",
      "file_type": "concept",
      "source_file": "/Users/sadegh/Elajgar/.agents/skills/prisma-database-setup/references/sqlite.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "No enums (Prisma polyfills/treats as String), no scalar lists (String[] unsupported), write operations lock the file."
    }
