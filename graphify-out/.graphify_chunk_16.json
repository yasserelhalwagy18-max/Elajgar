base instead of provisioning a new one; updates or creates .env with DATABASE_URL; supports CI via --api-key and --database flags, --force to re-link; then run prisma generate and prisma migrate dev."},{"id":"_agents_skills_prisma_postgres_references_console_and_connections_connection_endpoints","label":"direct and pooled connection endpoints","file_type":"concept","source_file":"/Users/sadegh/Elajgar/.agents/skills/prisma-postgres/references/console-and-connections.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Management API connection responses expose endpoints.direct (db.prisma.io:5432) and endpoints.pooled (pooled.db.prisma.io:5432); prefer these over the deprecated flat connectionString; direct TCP requires sslmode=require; connection secrets are one-time view and must be stored immediately."},{"id":"_agents_skills_prisma_postgres_references_console_and_connections_adapter_pg","label":"@prisma/adapter-pg","file_type":"concept","source_file":"/Users/sadegh/Elajgar/.agents/skills/prisma-postgres/references/console-and-connections.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Preferred adapter for standard Node.js apps with the direct TCP URL."},{"id":"_agents_skills_prisma_postgres_references_console_and_connections_adapter_ppg","label":"@prisma/adapter-ppg with @prisma/ppg","file_type":"concept","source_file":"/Users/sadegh/Elajgar/.agents/skills/prisma-postgres/references/console-and-connections.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"For edge/serverless runtimes when you specifically need the Prisma Postgres serverless driver."}],"edges":[{"source":"_agents_skills_prisma_postgres_references_create_db_cli_create_db_cli","target":"_agents_skills_prisma_postgres_references_create_db_cli_create_command","relation":"references","confidence":"EXTRACTED","confidence_score"