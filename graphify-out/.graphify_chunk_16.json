{"nodes":[{"id":"_agents_skills_prisma_postgres_references_create_db_cli_create_db_cli","label":"create-db CLI","file_type":"concept","source_file":"/Users/sadegh/Elajgar/.agents/skills/prisma-postgres/references/create-db-cli.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"CRITICAL priority — fastest way to get a working Prisma Postgres instance for development, demos, and CI previews; supports machine-readable JSON output and writes DATABASE_URL and CLAIM_URL directly into a target .env file."},{"id":"_agents_skills_prisma_postgres_references_create_db_cli_create_command","label":"create-db create command","file_type":"concept","source_file":"/Users/sadegh/Elajgar/.agents/skills/prisma-postgres/references/create-db-cli.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Default (top-level) command that provisions a database; databases are temporary by default and unclaimed databases are auto-deleted after ~24 hours unless claimed via the claim URL."},{"id":"_agents_skills_prisma_postgres_references_create_db_cli_regions_command","label":"create-db regions command","file_type":"concept","source_file":"/Users/sadegh/Elajgar/.agents/skills/prisma-postgres/references/create-db-cli.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"_agents_skills_prisma_postgres_references_create_db_cli_create_function","label":"create() function","file_type":"concept","source_file":"/Users/sadegh/Elajgar/.agents/skills/prisma-postgres/references/create-db-cli.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Programmatic database creation from the create-db library API; defaults to the us-east-1 region when no region is passed."},{"id":"_agents_skills_prisma_postgres_references_create_db_cli_regions_function","label":"regions() function","file_type":"conc